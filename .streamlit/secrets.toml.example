# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Render, set the same names as Environment Variables instead.

# ---- AI provider -------------------------------------------------------------------------------
# provider: gemini | groq | openrouter | ollama | openai_compatible | mistral | anthropic
#   gemini      Google AI Studio, open Gemma models, free tier       key: GEMINI_API_KEY   (aistudio.google.com)
#   groq        open models (gpt-oss, Llama, Qwen), free tier          key: GROQ_API_KEY     (console.groq.com)
#   openrouter  many open models; ":free" models                       key: OPENROUTER_API_KEY (openrouter.ai)
#   ollama      open model on your own computer/server, free+private   no key; base_url optional
#   openai_compatible  any other OpenAI-style API (vLLM, LM Studio...)  key: LLM_API_KEY + base_url + model
provider = "gemini"
GEMINI_API_KEY = "paste-your-key-here"
model = "gemma-3-27b-it"            # leave out to use the provider's default model

# Optional: when the main provider is rate-limited, try these next (only the ones with a key are used).
fallback_providers = "groq,openrouter"
GROQ_API_KEY = ""
OPENROUTER_API_KEY = ""
# groq_model = "openai/gpt-oss-120b"
# openrouter_model = "openai/gpt-oss-120b:free"

# Ollama example (app and Ollama on the same machine):
# provider = "ollama"
# model = "qwen3:14b"
# base_url = "http://localhost:11434/v1"

# ---- Accounts ----------------------------------------------------------------------------------
# Optional: require this code to create an account (the very first account never needs it).
signup_code = ""
