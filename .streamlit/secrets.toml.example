# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Render, set the same names as Environment Variables instead.

# ---- AI providers (backup chain) ---------------------------------------------------------------
# The main provider is tried first. If it is rate-limited, out of quota, or the request is too large for it,
# the next provider answers: Mistral -> Gemini (Gemma) -> Groq. Only providers with a key are used.
provider = "mistral"
model = "ministral-14b-latest"                 # model for the main provider

MISTRAL_API_KEY = "paste-your-mistral-key"     # console.mistral.ai
GEMINI_API_KEY = "paste-your-gemini-key"       # aistudio.google.com/apikey  (open Gemma models)
GROQ_API_KEY = "paste-your-groq-key"           # console.groq.com/keys       (gpt-oss-120b)

# Optional: change the backup order, or the backup models.
# fallback_providers = "gemini,groq"
# gemini_model = "gemma-3-27b-it"
# groq_model = "openai/gpt-oss-120b"

# Other providers: openrouter (OPENROUTER_API_KEY), ollama (local, no key), openai_compatible
# (LLM_API_KEY + base_url + model), anthropic (ANTHROPIC_API_KEY).

# ---- Accounts ----------------------------------------------------------------------------------
# Optional: require this code to create an account (the very first account never needs it).
signup_code = ""
