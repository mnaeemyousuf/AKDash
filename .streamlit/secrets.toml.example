# Copy this file to .streamlit/secrets.toml and fill in your values.

# AI provider: "mistral" (default) or "anthropic"
provider = "mistral"
MISTRAL_API_KEY = "paste-your-mistral-key-here"
# Free tier: "ministral-14b-latest" (mistral-large/medium/small allow 0 requests on the free plan)
model = "ministral-14b-latest"

# To use Claude instead:
# provider = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."
# model = "claude-sonnet-5-5"

# Optional: require this code to create an account (the very first account never needs it).
# Leave empty to let anyone who can open the app register.
signup_code = ""
